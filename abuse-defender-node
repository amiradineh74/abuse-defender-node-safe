#!/usr/bin/env bash
set -Eeuo pipefail
PATH=/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin

UPSTREAM='https://raw.githubusercontent.com/Kiya6955/Abuse-Defender/main/abuse-ips.ipv4'
CONF_DIR=/etc/abuse-defender-node
STATE_DIR=/var/lib/abuse-defender-node
LIST_FILE="$STATE_DIR/abuse-ips.ipv4"
WL_FILE="$CONF_DIR/whitelist.txt"
CUSTOM_FILE="$CONF_DIR/custom-block.txt"
CHAIN='PGAD_ABUSE_GUARD'
HOSTS_MARK='# abuse-defender-node-safe'
IPT=(iptables -w 10)

log(){ printf '[abuse-defender-node] %s\n' "$*"; }
die(){ printf '[abuse-defender-node] ERROR: %s\n' "$*" >&2; exit 1; }
need_root(){ [[ ${EUID:-999} -eq 0 ]] || die 'Run as root.'; }

ensure_dirs(){
  mkdir -p "$CONF_DIR" "$STATE_DIR"
  touch "$WL_FILE" "$CUSTOM_FILE"
  chmod 700 "$CONF_DIR" "$STATE_DIR"
  chmod 600 "$WL_FILE" "$CUSTOM_FILE"
}

valid_cidr(){
  python3 - "$1" <<'PY' >/dev/null
import ipaddress, sys
n = ipaddress.ip_network(sys.argv[1], strict=False)
if n.version != 4:
    raise SystemExit(1)
PY
}

file_entries(){
  local f=$1
  [[ -f "$f" ]] || return 0
  sed 's/#.*$//' "$f" | awk 'NF {for(i=1;i<=NF;i++) print $i}'
}

validate_file(){
  local f=$1
  [[ -s "$f" ]] || return 1
  python3 - "$f" <<'PY'
import ipaddress, sys
items=[]
with open(sys.argv[1], encoding='utf-8') as fh:
    for raw in fh:
        line=raw.split('#',1)[0].strip()
        if line:
            items.extend(line.split())
if not (20 <= len(items) <= 10000):
    raise SystemExit(2)
for item in items:
    n=ipaddress.ip_network(item, strict=False)
    if n.version != 4:
        raise SystemExit(3)
print(len(items))
PY
}

fetch_list(){
  ensure_dirs
  local tmp count
  tmp=$(mktemp "$STATE_DIR/.abuse-ips.XXXXXX")
  trap 'rm -f "$tmp"' RETURN
  curl --fail --silent --show-error --location        --connect-timeout 10 --max-time 30 --retry 3 --retry-delay 2        "$UPSTREAM" -o "$tmp"
  count=$(validate_file "$tmp") || die 'Downloaded upstream list failed validation; current rules were left untouched.'
  mv -f "$tmp" "$LIST_FILE"
  chmod 600 "$LIST_FILE"
  trap - RETURN
  log "Official upstream list updated ($count IPv4 networks)."
}

dynamic_whitelist(){
  echo '127.0.0.0/8'

  ip -o -4 addr show 2>/dev/null |
    awk '{split($4,a,"/"); if (a[1] != "") print a[1]"/32"}'

  ip -4 route show default 2>/dev/null |
    awk '/^default/ && $3 ~ /^[0-9.]+$/ {print $3"/32"; exit}'

  ip -4 route show table main scope link 2>/dev/null |
    awk '$1 ~ /^[0-9]+\./ {print $1}'

  if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
    docker network ls -q 2>/dev/null | while read -r id; do
      [[ -n "$id" ]] || continue
      docker network inspect "$id"         --format '{{range .IPAM.Config}}{{if .Subnet}}{{.Subnet}}{{"\n"}}{{end}}{{end}}'         2>/dev/null || true
    done
  fi
}

ensure_hosts(){
  grep -Fq "127.0.0.1 appclick.co $HOSTS_MARK" /etc/hosts 2>/dev/null ||
    echo "127.0.0.1 appclick.co $HOSTS_MARK" >> /etc/hosts
  grep -Fq "127.0.0.1 pushnotificationws.com $HOSTS_MARK" /etc/hosts 2>/dev/null ||
    echo "127.0.0.1 pushnotificationws.com $HOSTS_MARK" >> /etc/hosts
}

remove_hosts(){
  sed -i "\\|$HOSTS_MARK|d" /etc/hosts
}

ensure_chain(){
  "${IPT[@]}" -N "$CHAIN" 2>/dev/null || true
}

remove_output_hooks(){
  while "${IPT[@]}" -C OUTPUT -j "$CHAIN" 2>/dev/null; do
    "${IPT[@]}" -D OUTPUT -j "$CHAIN"
  done
}

apply_rules(){
  need_root
  ensure_dirs
  [[ -s "$LIST_FILE" ]] || fetch_list
  validate_file "$LIST_FILE" >/dev/null || die 'Cached official list is invalid.'

  ensure_chain
  "${IPT[@]}" -F "$CHAIN"

  {
    dynamic_whitelist
    file_entries "$WL_FILE"
  } | awk 'NF && !seen[$0]++' | while read -r cidr; do
    valid_cidr "$cidr" || die "Invalid whitelist CIDR: $cidr"
    "${IPT[@]}" -A "$CHAIN" -d "$cidr" -j RETURN
  done

  file_entries "$CUSTOM_FILE" | awk 'NF && !seen[$0]++' | while read -r cidr; do
    valid_cidr "$cidr" || die "Invalid custom block CIDR: $cidr"
    "${IPT[@]}" -A "$CHAIN" -d "$cidr" -j DROP
  done

  file_entries "$LIST_FILE" | awk 'NF' | while read -r cidr; do
    valid_cidr "$cidr" || die "Invalid upstream CIDR: $cidr"
    "${IPT[@]}" -A "$CHAIN" -d "$cidr" -j DROP
  done

  "${IPT[@]}" -A "$CHAIN" -j RETURN
  remove_output_hooks
  "${IPT[@]}" -I OUTPUT 1 -j "$CHAIN"
  ensure_hosts

  log 'Rules applied to OUTPUT. No Docker/BackPack chains were flushed or restored.'
}

stop_rules(){
  need_root
  remove_output_hooks
  if "${IPT[@]}" -L "$CHAIN" -n >/dev/null 2>&1; then
    "${IPT[@]}" -F "$CHAIN" || true
    "${IPT[@]}" -X "$CHAIN" || true
  fi
  log 'Project rules removed; other firewall rules were left untouched.'
}

update_rules(){
  need_root
  fetch_list
  apply_rules
}

schedule_rollback(){
  local unit="abuse-defender-node-rollback-$(date +%s)-$$"
  systemd-run --quiet --unit="$unit" --on-active=2m "$0" stop >/dev/null
  printf '%s\n' "$unit" > "$STATE_DIR/rollback-unit"
  log "TEST MODE active; automatic rollback in 2 minutes ($unit)."
}

cancel_rollback(){
  local unit=''
  [[ -f "$STATE_DIR/rollback-unit" ]] && unit=$(cat "$STATE_DIR/rollback-unit" 2>/dev/null || true)
  if [[ -n "$unit" ]]; then
    systemctl stop "$unit.timer" 2>/dev/null || true
    systemctl stop "$unit.service" 2>/dev/null || true
    systemctl reset-failed "$unit.service" 2>/dev/null || true
  fi
  rm -f "$STATE_DIR/rollback-unit"
}

confirm_rules(){
  need_root
  cancel_rollback
  systemctl enable abuse-defender-node.service abuse-defender-node-update.timer >/dev/null
  systemctl start abuse-defender-node.service
  systemctl start abuse-defender-node-update.timer
  log 'Confirmed: boot apply and daily upstream update enabled.'
}

status_rules(){
  echo '=== OUTPUT hook ==='
  "${IPT[@]}" -S OUTPUT 2>/dev/null | grep -F "$CHAIN" || echo 'Not hooked'
  echo
  echo '=== Chain counters ==='
  "${IPT[@]}" -L "$CHAIN" -n -v --line-numbers 2>/dev/null || echo 'Chain absent'
  echo
  echo '=== Cached list ==='
  [[ -f "$LIST_FILE" ]] && { wc -l "$LIST_FILE"; stat -c 'mtime: %y' "$LIST_FILE" 2>/dev/null || true; } || echo 'No cached list'
  echo
  echo '=== systemd ==='
  systemctl is-enabled abuse-defender-node.service 2>/dev/null || true
  systemctl is-enabled abuse-defender-node-update.timer 2>/dev/null || true
  systemctl is-active abuse-defender-node-update.timer 2>/dev/null || true
}

add_whitelist(){
  need_root; ensure_dirs
  local cidr=${1:-}
  [[ -n "$cidr" ]] || die 'Usage: add-whitelist CIDR'
  valid_cidr "$cidr" || die 'Invalid IPv4 CIDR.'
  grep -Fxq "$cidr" "$WL_FILE" || echo "$cidr" >> "$WL_FILE"
  apply_rules
}

add_block(){
  need_root; ensure_dirs
  local cidr=${1:-}
  [[ -n "$cidr" ]] || die 'Usage: add-block CIDR'
  valid_cidr "$cidr" || die 'Invalid IPv4 CIDR.'
  grep -Fxq "$cidr" "$CUSTOM_FILE" || echo "$cidr" >> "$CUSTOM_FILE"
  apply_rules
}

uninstall_all(){
  need_root
  cancel_rollback
  systemctl disable --now abuse-defender-node-update.timer 2>/dev/null || true
  systemctl disable abuse-defender-node.service 2>/dev/null || true
  stop_rules
  remove_hosts
  rm -f /etc/systemd/system/abuse-defender-node.service         /etc/systemd/system/abuse-defender-node-update.service         /etc/systemd/system/abuse-defender-node-update.timer
  systemctl daemon-reload
  log 'Uninstalled runtime/systemd integration. Config and cached list were kept.'
}

need_root
case "${1:-}" in
  test) fetch_list; apply_rules; schedule_rollback ;;
  confirm) confirm_rules ;;
  apply) apply_rules ;;
  update) update_rules ;;
  stop) stop_rules ;;
  status) status_rules ;;
  fetch) fetch_list ;;
  add-whitelist) add_whitelist "${2:-}" ;;
  add-block) add_block "${2:-}" ;;
  uninstall) uninstall_all ;;
  *)
    echo 'Usage: abuse-defender-node {test|confirm|apply|update|stop|status|fetch|add-whitelist CIDR|add-block CIDR|uninstall}'
    exit 1
    ;;
esac
